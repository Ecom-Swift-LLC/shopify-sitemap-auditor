    "node": ">=18"
  },
  "scripts": {
    "test": "node --test"
  },
  "files": [
    "bin",
    "lib",
    "samples"
  ],
  "keywords": [
    "shopify",
    "sitemap",
    "sitemap-xml",
    "seo",
    "technical-seo",
    "crawling",
    "audit",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ecom-Swift-LLC/shopify-sitemap-auditor.git"
  },
