{
  "name": "shopify-sitemap-auditor",
  "version": "1.0.0",
  "description": "Audits a Shopify store's sitemap.xml and every child sitemap: empty or missing sitemaps, redirecting or dead URLs, wrong host, bad lastmod dates, duplicates, and URLs that robots.txt blocks.",
